        "Start here",
        "Handbook"
      ],
      "maxLength": 1020,
      "pattern": "^[^\\x00-\\x1f\\x7f]{1,255}$"
    },
    "Slug": {
      "title": "Slug",
      "description": "The slug of one page: unique in its release, and the last part of\n`/v1/sites/{site}/content/pages/{slug}`.\n\nSegments of lower-case ASCII letters, digits and `-`, separated by `/`, at most 1024\ncharacters. The release builder takes the frontmatter key `slug`, or else the vault path\nwithout `.md`, lower-cased, with each run of other characters than ASCII letters, digits\nand `/` replaced by one `-` (workspace spec `site-publications`).",
      "type": "string",
      "examples": [
        "handbook/start",
        "notes/a-b"
      ],
      "maxLength": 1024,
      "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)*$"
    },
    "TableAlign": {
      "description": "The alignment of a table column.",
      "oneOf": [
        {
          "description": "`:--`.",
